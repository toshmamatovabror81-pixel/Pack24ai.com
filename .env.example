# Serverda: cp .env.example .env  (deploy/server-setup.sh buni avtomatik to'ldiradi)
# Hech qachon .env ni git'ga qo'shmang.

# Sayt domeni (Caddy shu domen uchun HTTPS sertifikat oladi; sayt manzili https://DOMAIN bo'ladi)
DOMAIN="pack24.uz"
# Lokal ishlab chiqishda sayt manzili (Docker'da compose DOMAIN'dan o'zi yasaydi)
# APP_URL="http://localhost:3000"
# staging bo'lsa sayt qidiruv tizimlarida indekslanmaydi
SITE_ENV="production"

# Postgres paroli (docker-compose DATABASE_URL ni shundan yasaydi)
POSTGRES_PASSWORD=""

# Lokal ishlab chiqish uchun (Docker'da compose o'zi beradi)
# DATABASE_URL="postgresql://pack24:PAROL@localhost:5432/pack24"
# DIRECT_URL="postgresql://pack24:PAROL@localhost:5432/pack24"

# Sessiya imzosi, kamida 32 belgi (openssl rand -hex 32)
AUTH_SECRET=""

# Birinchi admin (faqat bazada hali admin bo'lmasa ishlatiladi; keyin admin paneldan boshqariladi)
ADMIN_USERNAME="admin"
ADMIN_PASSWORD=""

# Rasmlar: server diski (Docker volume /data/uploads). Ixtiyoriy: STORAGE_DRIVER=supabase
# UPLOAD_DIR="./uploads"

# To'lovlar (Payme va Click kabinetidan)
PAYME_MERCHANT_ID=""
PAYME_SECRET_KEY=""
PAYME_TEST_MODE="false"
CLICK_SERVICE_ID=""
CLICK_MERCHANT_ID=""
CLICK_SECRET_KEY=""

# Telegram: yangi buyurtma va arizalar haqida admin guruhiga xabar (quyidagi botlardan mustaqil ishlaydi)
TELEGRAM_BOT_TOKEN=""
TELEGRAM_ADMIN_CHAT_ID=""

# ─── Telegram botlar (BotFather'dan) ─────────────────────────────────────────
# 2 ta bot: mijoz (@Pack24AI_bot — buyurtmalar, balans, holat o'zgarishi haqida xabarnomalar) va boshqaruv
# (@pack24AUP_bot — xodimlar uchun: yangi buyurtmalar, holatni o'zgartirish, kunlik eslatma).
# Mijoz botda telefonini ulashadi; xodim Admin > Xodimlar sahifasi orqali ulanadi.
# Savol-javob bilan yozish: deploy/bots-setup.sh
CUSTOMER_BOT_TOKEN=""
STAFF_BOT_TOKEN=""
# Webhook imzosi va bot sozlash API kaliti, kamida 16 belgi (deploy/server-setup.sh o'zi yaratadi).
# TELEGRAM_OPS_SECRET bilan server cron'i davriy ishlar signalini ham yuboradi (deploy/auto-update.sh -> /api/cron/tick)
TELEGRAM_WEBHOOK_SECRET=""
TELEGRAM_OPS_SECRET=""

# ─── Sun'iy intellekt (Anthropic Claude) ─────────────────────────────────────
# Kalit bo'lsa: mijoz botida erkin yozilgan savollarga AI javob beradi (faqat shu mijozning o'z buyurtma va balansi bo'yicha)
# va kunlik tekshiruvga (Admin > AI tekshiruv, har kuni 08:00) AI xulosasi qo'shiladi. Kalit bo'lmasa bu ikkisi AI'siz ishlaydi.
# Kalit: console.anthropic.com > API Keys. Savol-javob bilan yozish va sinash: deploy/ai-setup.sh
ANTHROPIC_API_KEY=""
# Model: claude-opus-5-5 (eng aqlli, standart), claude-sonnet-5-5 (muvozanatli), claude-haiku-5-5 (eng arzon)
ANTHROPIC_MODEL=""
# Xarajat chegaralari: kuniga jami so'rovlar (standart 300) va bitta mijoz uchun (standart 20; telefonini ulamagan chatga — 3).
# O'zgartirish uchun satr boshidagi # ni olib tashlang (bo'sh qiymat ham standart degani)
# AI_DAILY_LIMIT="300"
# AI_CUSTOMER_DAILY_LIMIT="20"

# ─── Serverdan tashqaridagi zaxira nusxa (ixtiyoriy) ─────────────────────────
# Parol bo'lsa, har kunlik baza nusxasi shu parol bilan shifrlanib (AES-256), boshqaruv boti orqali administratorlarga
# Telegram'da fayl bo'lib yuboriladi. Parolni egasi o'zi o'ylab topadi va eslab qoladi. Yozish: deploy/offsite-setup.sh
BACKUP_PASSPHRASE=""
