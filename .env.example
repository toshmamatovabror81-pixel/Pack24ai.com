# Serverda: cp .env.example .env  (deploy/server-setup.sh buni avtomatik to'ldiradi)
# Hech qachon .env ni git'ga qo'shmang.

# Sayt domeni (Caddy shu domen uchun HTTPS sertifikat oladi; sayt manzili https://DOMAIN bo'ladi)
DOMAIN="pack24.uz"
# Lokal ishlab chiqishda sayt manzili (Docker'da compose DOMAIN'dan o'zi yasaydi)
# APP_URL="http://localhost:3000"
# staging bo'lsa sayt qidiruv tizimlarida indekslanmaydi
SITE_ENV="production"

# Postgres paroli (docker-compose DATABASE_URL ni shundan yasaydi)
POSTGRES_PASSWORD=""

# Lokal ishlab chiqish uchun (Docker'da compose o'zi beradi)
# DATABASE_URL="postgresql://pack24:PAROL@localhost:5432/pack24"
# DIRECT_URL="postgresql://pack24:PAROL@localhost:5432/pack24"

# Sessiya imzosi, kamida 32 belgi (openssl rand -hex 32)
AUTH_SECRET=""

# Birinchi admin (faqat bazada hali admin bo'lmasa ishlatiladi; keyin admin paneldan boshqariladi)
ADMIN_USERNAME="admin"
ADMIN_PASSWORD=""

# Rasmlar: server diski (Docker volume /data/uploads). Ixtiyoriy: STORAGE_DRIVER=supabase
# UPLOAD_DIR="./uploads"

# To'lovlar (Payme va Click kabinetidan)
PAYME_MERCHANT_ID=""
PAYME_SECRET_KEY=""
PAYME_TEST_MODE="false"
CLICK_SERVICE_ID=""
CLICK_MERCHANT_ID=""
CLICK_SECRET_KEY=""

# Telegram: yangi buyurtma va arizalar haqida xabar
TELEGRAM_BOT_TOKEN=""
TELEGRAM_ADMIN_CHAT_ID=""

# ─── Telegram botlar (BotFather'dan) ─────────────────────────────────────────
# 2 ta bot: mijoz (@Pack24AI_bot) va boshqaruv (@pack24AUP_bot, xodimlar uchun).
# Savol-javob bilan yozish: deploy/bots-setup.sh
CUSTOMER_BOT_TOKEN=""
STAFF_BOT_TOKEN=""
# Webhook imzosi va bot sozlash API kaliti, kamida 16 belgi (deploy/server-setup.sh o'zi yaratadi)
TELEGRAM_WEBHOOK_SECRET=""
TELEGRAM_OPS_SECRET=""
