# Caddy: HTTPS sertifikatini (Let's Encrypt) o'zi oladi va yangilaydi.
# DOMAIN .env dan keladi (standart: pack24.uz)

www.{$DOMAIN} {
	redir https://{$DOMAIN}{uri} permanent
}

{$DOMAIN} {
	encode zstd gzip
	reverse_proxy web:3000

	# Statik fayllar uzoq keshlanadi
	@static path /_next/static/* /images/* /uploads/*
	header @static Cache-Control "public, max-age=31536000, immutable"

	log {
		output file /data/access.log {
			roll_size 50mb
			roll_keep 5
		}
	}
}
