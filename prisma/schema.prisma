// This is your Prisma schema file

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ─── Enum turlar ─────────────────────────────────────────────────────────────

enum OrderStatus {
  draft
  new_       @map("new")
  processing
  shipping
  delivered
  cancelled
}

enum PaymentStatus {
  pending
  processing
  paid
  failed
  refunded
}

enum ProductStatus {
  active
  draft
  archived
}

enum WorkOrderStatus {
  planned
  in_progress
  completed
  paused
  cancelled
}

enum WorkOrderStageStatus {
  pending
  in_progress
  completed
}

enum CampaignStatus {
  draft
  scheduled
  sent
}

enum TaskStatus {
  pending
  in_progress
  review
  completed
  cancelled
}

enum TaskPriority {
  low
  normal
  high
  urgent
}

enum TaskAssigneeRole {
  assignee
  reviewer
  observer
}

enum TaskAssigneeStatus {
  assigned
  in_progress
  completed
  declined
}

enum NotificationStatus {
  sent
  delivered
  read
  accepted
  failed
  escalated
}

enum ContractStatus {
  active
  suspended
  closed
}

enum InvoiceStatus {
  issued
  paid
  partial
  overdue
  cancelled
}

// ─── P2.4 audit: yangi enum'lar ─────────────────────────────────────────────

enum UserRole {
  user
  staff
  manager
  admin
}

enum CustomerType {
  individual
  corporate
  wholesale
  dealer
}

enum CustomerGroup {
  standard
  vip
  new_     @map("new")
  inactive
  blocked
}

enum CampaignType {
  telegram
  sms
  email
}

// ─── P3 audit: string → enum o'tkazish ──────────────────────────────────────

enum StockMovementType {
  IN
  OUT
  TRANSFER
}

enum AssignmentType {
  individual
  group
}

enum TaskDepartment {
  warehouse
  logistics
  production
  household
  general
}

enum NotificationChannel {
  telegram
  sms
  call
}

enum PushPlatform {
  web
  ios
  android
}

enum AppType {
  web
  customer
  driver
}

enum ProductionStage {
  gofra
  pechat
  yiguv
  qc
}

enum DeliveryMethod {
  courier
  pickup
}

enum PaymentMethod {
  cash
  click
  payme
  bank_transfer
}

enum MediaType {
  image
  video
}

enum PerformanceKind {
  quality
  speed
  discipline
  initiative
  penalty
}

// ─── Foydalanuvchi modeli ────────────────────────────────────────────────────
model User {
  id           Int      @id @default(autoincrement())
  name         String
  email        String?  @unique
  phone        String   @unique
  passwordHash String
  role         UserRole @default(user)
  isActive     Boolean  @default(true)

  // ─── Xodim klassifikatsiyasi ────────────────
  department     String? // warehouse, logistics, production, household, sales, management
  position       String? // Lavozim: Omborchi, Operator, Menejer, h.k.
  telegramNotify Boolean @default(true) // Telegram xabar olish
  smsNotify      Boolean @default(true) // SMS xabar olish

  // ─── Telegram orqali ro'yxatdan o'tish ───
  telegramId         String?   @unique // Telegram user ID
  telegramCode       String? // Xodimni boshqaruv botiga ulash uchun bir martalik kod (muddati otpExpiry da)
  telegramVerifiedAt DateTime? // Telegram orqali tasdiqlangan vaqt

  // ─── OTP (Bir martalik kod — saytga kirish uchun) ─
  otpCode     String? // Telegram orqali yuborilgan OTP
  otpExpiry   DateTime? // OTP amal qilish muddati (5 daqiqa)
  otpAttempts Int       @default(0) // Noto'g'ri urinishlar soni

  // ─── Mijoz klassifikatsiyasi ──────────────
  customerType  CustomerType  @default(individual)
  customerGroup CustomerGroup @default(standard)
  companyName   String?
  address       String?
  notes         String?

  // Referral System
  referralCode String? @unique
  referredById Int?
  referredBy   User?   @relation("UserReferrals", fields: [referredById], references: [id], onDelete: SetNull)
  referrals    User[]  @relation("UserReferrals")

  orders            Order[]
  contracts         Contract[]
  pushSubscriptions PushSubscription[]

  // Ichki vazifalar (jamoaviy topshiriqlar)
  tasksCreated         Task[]                 @relation("TaskCreatedBy")
  taskAssignments      TaskAssignee[]
  taskCommentsAuthored TaskComment[]
  performanceReceived  TaskPerformanceEntry[] @relation("PerformanceSubject")
  performanceRecorded  TaskPerformanceEntry[] @relation("PerformanceAuthor")
  taskNotifications    TaskNotification[]     @relation("NotificationRecipient")

  // Stories
  stories    Story[]
  storyViews StoryView[] @relation("StoryViews")

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?
}

// ─── Push Notification Subscriptionlar ───────────────────────────────────────
model PushSubscription {
  id        Int          @id @default(autoincrement())
  endpoint  String?      @unique // Browser push endpoint URL
  p256dh    String? // Public ECDH key
  auth      String? // Auth secret
  token     String?      @unique // Expo Push Token (mobil)
  userId    Int? // Autentifikatsiya qilingan foydalanuvchi
  user      User?        @relation(fields: [userId], references: [id], onDelete: SetNull)
  driverId  Int? // Haydovchi (mobil)
  platform  PushPlatform @default(web)
  appType   AppType      @default(web)
  userAgent String? // Browser turi
  isActive  Boolean      @default(true)
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt

  @@index([driverId])
  @@index([appType, isActive])
  @@index([userId])
}

// ──────────────────────────────────────────────────────────────────────────────

model Campaign {
  id        Int            @id @default(autoincrement())
  type      CampaignType
  content   String
  audience  String
  status    CampaignStatus
  sentAt    DateTime?
  receivers Int            @default(0)
  views     Int            @default(0)
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt
}

model TelegramConfig {
  id             Int      @id @default(autoincrement())
  botToken       String   @default("")
  botUsername    String   @default("")
  welcomeMessage String   @default("Assalomu alaykum! Xush kelibsiz.")
  mainButton     String   @default("Katalog")
  isActive       Boolean  @default(false)
  salesChatId    String   @default("")
  updatedAt      DateTime @updatedAt
}

model Product {
  id              Int           @id @default(autoincrement())
  name            String
  description     String?
  nameI18n        Json          @default("{}") // {"uz":"...","ru":"...","en":"..."}
  descriptionI18n Json          @default("{}") // {"uz":"...","ru":"...","en":"..."}
  price           Decimal       @db.Decimal(18, 2)
  originalPrice   Decimal?      @db.Decimal(18, 2)
  sku             String?
  category        String?
  categoryId      Int? // Yangi: Category relation
  categoryRel     Category?     @relation(fields: [categoryId], references: [id])
  image           String
  gallery         Json          @default("[]")
  videoUrl        String?
  specifications  Json          @default("{}")
  tags            Json          @default("[]")
  minQuantity     Int           @default(1)
  inStock         Boolean       @default(true)
  rating          Float         @default(0)
  reviews         Int           @default(0)
  status          ProductStatus @default(active)
  isFeatured      Boolean       @default(false) // Kategoriya namuna mahsuloti
  sourceUrl       String?
  // v2: ulgurji narx pog'onalari [{"minQty":100,"price":"1200"}]
  priceTiers      Json          @default("[]")
  items           OrderItem[]

  inventory      Inventory[]
  stockMovements StockMovement[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status, createdAt])
  @@index([category, status])
  @@index([categoryId])
}

model Category {
  id              Int        @id @default(autoincrement())
  name            String
  slug            String     @unique
  image           String?
  parentId        Int?
  parent          Category?  @relation("CategoryTree", fields: [parentId], references: [id], onDelete: SetNull)
  children        Category[] @relation("CategoryTree")
  products        Product[]
  // v2: tarjimalar va SEO matni (kategoriya sahifasi uchun)
  nameI18n        Json       @default("{}") // {"uz":"...","ru":"...","en":"..."}
  descriptionI18n Json       @default("{}") // Kategoriya sahifasidagi SEO matn
  sortOrder       Int        @default(0)
  isActive        Boolean    @default(true)
  createdAt       DateTime   @default(now())
  updatedAt       DateTime   @updatedAt

  @@index([parentId])
}

model Order {
  id             Int     @id @default(autoincrement())
  telegramUserId String? // Mijoz botida shu buyurtma havolasi (/start <token>) orqali ulangan Telegram ID
  customerName   String?
  contactPhone   String?

  // Yangi: User relation (opsional — mavjud orderlar uchun)
  userId Int?
  user   User? @relation(fields: [userId], references: [id])

  status      OrderStatus @default(draft)
  totalAmount Decimal     @default(0) @db.Decimal(18, 2)

  shippingAddress  String?
  shippingLocation String? // JSON or "lat,long"
  comment          String? // Buyurtma izohi
  deliveryMethod   DeliveryMethod?

  paymentMethod PaymentMethod?
  paymentStatus PaymentStatus  @default(pending)

  // Yangi: Status timestamp'lar — analytics uchun
  confirmedAt DateTime? // Tasdiqlangan
  shippedAt   DateTime? // Jo'natilgan
  deliveredAt DateTime? // Yetkazilgan
  cancelledAt DateTime? // Bekor qilingan

  // v2: narx tarkibi, promokod, kuzatuv havolasi
  subtotal       Decimal? @db.Decimal(18, 2)
  discountAmount Decimal  @default(0) @db.Decimal(18, 2)
  deliveryFee    Decimal  @default(0) @db.Decimal(18, 2)
  promoCode      String?
  accessToken    String?  @unique // Mehmon buyurtmani ko'rishi uchun maxfiy kalit
  // v2: marketing manbasi (UTM)
  source         String? // web, telegram, admin
  utmSource      String?
  utmMedium      String?
  utmCampaign    String?
  utmContent     String?
  utmTerm        String?
  referrer       String?
  landingPage    String?
  // v3 (B2B): yuridik shaxs rekvizitlari, hisob-faktura uchun
  companyName    String?
  companyInn     String?

  items             OrderItem[]
  corporateInvoices CorporateInvoice[]
  paymeTransactions PaymeTransaction[]
  workOrders        WorkOrder[]

  staffTasks Task[]
  events     OrderEvent[]

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  @@index([userId])
  @@index([status, createdAt])
  @@index([paymentStatus])
  @@index([contactPhone])
  @@index([telegramUserId])
}

// Buyurtma tarixi: holat va to'lov o'zgarishlari (kim, qayerdan). Admin sahifasi, botlar va tekshiruvlar uchun
model OrderEvent {
  id        Int      @id @default(autoincrement())
  orderId   Int
  order     Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  kind      String // status | payment
  fromValue String?
  toValue   String
  actor     String? // xodim ismi yoki tizim nomi
  via       String // admin | staff_bot | payme | click | invoice | system
  createdAt DateTime @default(now())

  @@index([orderId, createdAt])
}

model OrderItem {
  id        Int     @id @default(autoincrement())
  orderId   Int
  order     Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId Int
  product   Product @relation(fields: [productId], references: [id], onDelete: Restrict)
  quantity  Int
  price     Decimal @db.Decimal(18, 2) // Snapshot of price

  @@index([orderId])
  @@index([productId])
}

/// Payme JSON-RPC transaction mapping (CreateTransaction → PerformTransaction)
model PaymeTransaction {
  id          String   @id // Payme transaction ID
  orderId     Int
  order       Order    @relation(fields: [orderId], references: [id])
  amount      Int // tiyin
  state       Int      @default(1) // 1=created, 2=performed, -1=cancelled, -2=cancelled after perform
  createTime  BigInt
  performTime BigInt?
  cancelTime  BigInt?
  reason      Int?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([orderId])
}

model Warehouse {
  id       Int     @id @default(autoincrement())
  name     String
  location String?
  isMain   Boolean @default(false)

  inventory     Inventory[]
  movementsFrom StockMovement[] @relation("FromWarehouse")
  movementsTo   StockMovement[] @relation("ToWarehouse")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Inventory {
  id Int @id @default(autoincrement())

  productId Int
  product   Product @relation(fields: [productId], references: [id])

  warehouseId Int
  warehouse   Warehouse @relation(fields: [warehouseId], references: [id])

  quantity Int @default(0)

  updatedAt DateTime @updatedAt

  @@unique([productId, warehouseId])
}

model StockMovement {
  id Int @id @default(autoincrement())

  type StockMovementType

  productId Int
  product   Product @relation(fields: [productId], references: [id])

  fromWarehouseId Int?
  fromWarehouse   Warehouse? @relation("FromWarehouse", fields: [fromWarehouseId], references: [id])

  toWarehouseId Int?
  toWarehouse   Warehouse? @relation("ToWarehouse", fields: [toWarehouseId], references: [id])

  quantity Int
  reason   String?

  createdBy String? // User ID or name

  createdAt DateTime @default(now())
}

model WorkOrder {
  id      Int    @id @default(autoincrement())
  orderNo String @unique // e.g., ORD-2024-001

  clientName  String
  productName String
  quantity    Int
  deadline    DateTime

  status   WorkOrderStatus @default(planned)
  priority TaskPriority    @default(normal)

  progress     Int             @default(0) // 0-100%
  currentStage ProductionStage @default(gofra)

  // ─── Gofrokarton / Qadoq xususiyatlari ───
  size         String? // Mahsulot o'lchami ("Размер")
  sheetLength  Float? // List uzunligi
  sheetWidth   Float? // List kengligi
  areaPerPiece Float? // 1 dona uchun maydon (m2)
  totalArea    Float? // Umumiy maydon (m2)

  layerCount Int? // Qatlamlar soni (Слой)
  layer1     String? // 1-qatlam
  layer2     String? // 2-qatlam
  layer3     String? // 3-qatlam
  layer4     String? // 4-qatlam
  layer5     String? // 5-qatlam

  printType String? // Pechat turi (п/б)

  // v3 (B2B): qaysi buyurtma yoki ariza uchun
  orderId       Int?
  order         Order?  @relation(fields: [orderId], references: [id])
  leadId        Int?
  lead          Lead?   @relation(fields: [leadId], references: [id])
  customerPhone String?
  notes         String?

  stages WorkOrderStage[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([orderId])
  @@index([leadId])
  @@index([status, deadline])
}

model WorkOrderStage {
  id Int @id @default(autoincrement())

  workOrderId Int
  workOrder   WorkOrder @relation(fields: [workOrderId], references: [id], onDelete: Cascade)

  stage  ProductionStage
  status WorkOrderStageStatus @default(pending)

  startedAt   DateTime?
  completedAt DateTime?

  operator String?
  notes    String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// ─── Yangiliklar ──────────────────────────────────────────────────────────────
model News {
  id          Int      @id @default(autoincrement())
  titleUz     String
  titleRu     String
  descUz      String   @default("")
  descRu      String   @default("")
  emoji       String   @default("📰")
  badge       String   @default("Новость")
  publishedAt DateTime @default(now())
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

// ─── Telegram botlar ─────────────────────────────────────────────────────────

// Telegram bot suhbat holati (webhook'lar orasida saqlanadi; server qayta ishga tushsa ham yo'qolmaydi)
model BotSession {
  id         Int      @id @default(autoincrement())
  bot        String // customer | staff | staff_code (boshqaruv botida noto'g'ri ulash kodlari hisobi — telegram/session.ts SessionScope)
  telegramId String
  data       Json
  updatedAt  DateTime @updatedAt

  @@unique([bot, telegramId])
  @@index([updatedAt])
}

// Mijoz botidan foydalanuvchi: til va xabarnoma sozlamasi; telefon — faqat Telegram kontakti orqali tasdiqlangan
// bo'lsa to'ldiriladi (shundan keyin buyurtmalar va balans ko'rinadi). Saytda ro'yxatdan o'tmagan mijoz ham bo'lishi mumkin.
model TelegramCustomer {
  id         Int       @id @default(autoincrement())
  telegramId String    @unique
  phone      String? // 998XXXXXXXXX
  name       String?
  lang       String    @default("uz") // uz | ru
  notify     Boolean   @default(true) // buyurtma holati o'zgarsa xabar olish
  verifiedAt DateTime? // telefon tasdiqlangan vaqt
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  @@index([phone])
}

// ─── Ichki vazifalar / jamoa topshiriqlari (admin CRM ichki modul) ────────────
// assignmentType: individual | group
// status: pending | in_progress | review | completed | cancelled

model Task {
  id         Int     @id @default(autoincrement())
  publicCode String? @unique

  title       String
  description String         @default("")
  department  TaskDepartment @default(general)

  assignmentType AssignmentType @default(individual)
  status         TaskStatus     @default(pending)
  priority       TaskPriority   @default(normal)

  dueAt            DateTime?
  estimatedMinutes Int?
  progress         Int       @default(0)

  orderId Int?
  order   Order? @relation(fields: [orderId], references: [id], onDelete: SetNull)

  createdById Int?
  createdBy   User? @relation("TaskCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)

  qualityScore   Int?
  evaluationNote String?

  completedAt DateTime?

  assignees          TaskAssignee[]
  subtasks           TaskSubtask[]
  comments           TaskComment[]
  attachments        TaskAttachment[]
  performanceEntries TaskPerformanceEntry[]
  notifications      TaskNotification[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status, dueAt])
  @@index([department, status])
  @@index([orderId])
}

model TaskAssignee {
  id     Int  @id @default(autoincrement())
  taskId Int
  task   Task @relation(fields: [taskId], references: [id], onDelete: Cascade)
  userId Int
  user   User @relation(fields: [userId], references: [id], onDelete: Cascade)

  role   TaskAssigneeRole   @default(assignee)
  status TaskAssigneeStatus @default(assigned)

  createdAt   DateTime  @default(now())
  completedAt DateTime?

  @@unique([taskId, userId])
  @@index([userId])
}

model TaskSubtask {
  id        Int     @id @default(autoincrement())
  taskId    Int
  task      Task    @relation(fields: [taskId], references: [id], onDelete: Cascade)
  title     String
  done      Boolean @default(false)
  sortOrder Int     @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model TaskComment {
  id       Int    @id @default(autoincrement())
  taskId   Int
  task     Task   @relation(fields: [taskId], references: [id], onDelete: Cascade)
  authorId Int
  author   User   @relation(fields: [authorId], references: [id], onDelete: Cascade)
  body     String

  createdAt DateTime @default(now())

  @@index([taskId, createdAt])
}

model TaskPerformanceEntry {
  id     Int   @id @default(autoincrement())
  userId Int
  user   User  @relation("PerformanceSubject", fields: [userId], references: [id], onDelete: Cascade)
  taskId Int?
  task   Task? @relation(fields: [taskId], references: [id], onDelete: SetNull)

  kind    PerformanceKind
  points  Int?
  label   String
  details String?

  createdById Int?
  createdBy   User? @relation("PerformanceAuthor", fields: [createdById], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())

  @@index([userId, createdAt])
  @@index([taskId])
}

// ─── Vazifaga biriktirilgan fayllar (natija rasmlari, hujjatlar) ──────────────
model TaskAttachment {
  id           Int      @id @default(autoincrement())
  taskId       Int
  task         Task     @relation(fields: [taskId], references: [id], onDelete: Cascade)
  fileName     String
  fileUrl      String
  fileSize     Int?
  mimeType     String?
  uploadedById Int?
  createdAt    DateTime @default(now())

  @@index([taskId])
}

// ─── Vazifa bildirishnoma eskalatsiya tizimi ─────────────────────────────────
model TaskNotification {
  id     Int  @id @default(autoincrement())
  taskId Int
  task   Task @relation(fields: [taskId], references: [id], onDelete: Cascade)
  userId Int
  user   User @relation("NotificationRecipient", fields: [userId], references: [id], onDelete: Cascade)

  channel NotificationChannel
  status  NotificationStatus  @default(sent)

  sentAt      DateTime  @default(now())
  deliveredAt DateTime?
  readAt      DateTime?
  acceptedAt  DateTime?

  escalatedToSms  Boolean @default(false)
  escalatedToCall Boolean @default(false)
  escalationNote  String?

  createdAt DateTime @default(now())

  @@index([taskId, userId])
  @@index([status, sentAt])
  @@index([userId, channel])
}

// ─── Korporativ shartnoma ────────────────────────────────────────────────────
model Contract {
  id         Int    @id @default(autoincrement())
  contractNo String @unique // SH-2026-001
  userId     Int?
  user       User?  @relation(fields: [userId], references: [id])

  companyName  String // Kompaniya nomi
  inn          String? // INN (STIR raqami)
  mfo          String? // Bank MFO
  bankAccount  String? // Hisob raqami (P/P)
  bankName     String? // Bank nomi
  directorName String? // Direktor ismi

  address         String? // Yuridik manzil
  phone           String? // Aloqa telefoni
  creditLimit     Decimal @default(0) @db.Decimal(18, 2) // Nasiya limiti (so'm)
  paymentTermDays Int     @default(15) // To'lov muddati (kun)

  status    ContractStatus @default(active)
  startDate DateTime       @default(now())
  endDate   DateTime?
  notes     String?

  invoices CorporateInvoice[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@index([status])
}

// ─── Korporativ hisob-faktura ────────────────────────────────────────────────
model CorporateInvoice {
  id         Int       @id @default(autoincrement())
  invoiceNo  String    @unique // INV-2026-0001
  contractId Int?
  contract   Contract? @relation(fields: [contractId], references: [id])
  orderId    Int
  order      Order     @relation(fields: [orderId], references: [id])

  subtotal    Decimal @db.Decimal(18, 2) // QQS siz summa
  vatPercent  Float   @default(12) // QQS foizi
  vatAmount   Decimal @db.Decimal(18, 2) // QQS summasi
  totalAmount Decimal @db.Decimal(18, 2) // Jami (QQS bilan)

  status     InvoiceStatus @default(issued)
  dueDate    DateTime // To'lov muddati
  paidAmount Decimal       @default(0) @db.Decimal(18, 2)
  paidAt     DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([contractId, status])
  @@index([orderId])
  @@index([dueDate, status])
}

// ─── Stories ─────────────────────────────────────────────────────────────────

model Story {
  id          Int         @id @default(autoincrement())
  userId      Int
  user        User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  mediaUrl    String // Base64 data URI or external URL
  mediaType   MediaType   @default(image) // image | video
  caption     String?
  textOverlay Json? // {text, x, y, color, fontSize}
  viewCount   Int         @default(0)
  expiresAt   DateTime // createdAt + 24h
  createdAt   DateTime    @default(now())
  views       StoryView[]

  @@index([userId, expiresAt])
  @@index([expiresAt])
}

model StoryView {
  id       Int      @id @default(autoincrement())
  storyId  Int
  story    Story    @relation(fields: [storyId], references: [id], onDelete: Cascade)
  viewerId Int
  viewer   User     @relation("StoryViews", fields: [viewerId], references: [id], onDelete: Cascade)
  viewedAt DateTime @default(now())

  @@unique([storyId, viewerId])
  @@index([viewerId])
}

// ═══════════════════════════════════════════════════════════════════════════
// v2 (sayt qayta yozilgan, 2026-10): marketing va kontent
// ═══════════════════════════════════════════════════════════════════════════

enum DiscountType {
  percent
  fixed
}

model PromoCode {
  id          Int          @id @default(autoincrement())
  code        String       @unique
  type        DiscountType @default(percent)
  value       Decimal      @db.Decimal(18, 2)
  minSubtotal Decimal      @default(0) @db.Decimal(18, 2)
  maxUses     Int?
  usedCount   Int          @default(0)
  startsAt    DateTime?
  endsAt      DateTime?
  isActive    Boolean      @default(true)
  note        String?
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
}

model Banner {
  id        Int      @id @default(autoincrement())
  titleI18n Json     @default("{}")
  textI18n  Json     @default("{}")
  image     String?
  href      String?
  sortOrder Int      @default(0)
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

enum ReviewStatus {
  pending
  approved
  rejected
}

model Review {
  id         Int          @id @default(autoincrement())
  productId  Int?
  authorName String
  company    String?
  rating     Int          @default(5)
  text       String
  status     ReviewStatus @default(pending)
  createdAt  DateTime     @default(now())
  updatedAt  DateTime     @updatedAt

  @@index([status, createdAt])
  @@index([productId])
}

model Post {
  id          Int       @id @default(autoincrement())
  slug        String    @unique
  titleI18n   Json      @default("{}")
  excerptI18n Json      @default("{}")
  bodyI18n    Json      @default("{}") // Markdown matn har til uchun
  cover       String?
  isPublished Boolean   @default(false)
  publishedAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([isPublished, publishedAt])
}

model FaqItem {
  id           Int      @id @default(autoincrement())
  questionI18n Json     @default("{}")
  answerI18n   Json     @default("{}")
  sortOrder    Int      @default(0)
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

enum LeadType {
  wholesale // Ulgurji narx so'rash
  custom_box // Individual quti / bepul maket
  callback // Qayta qo'ng'iroq
  contact // Aloqa formasi
  recycling // Eski (makulatura yo'nalishi olib tashlangan): faqat tarixiy arizalar uchun qoldirilgan
}

enum LeadStatus {
  new_        @map("new")
  in_progress
  done
  rejected
}

model Lead {
  id          Int        @id @default(autoincrement())
  type        LeadType
  status      LeadStatus @default(new_)
  name        String
  phone       String
  company     String?
  message     String?
  details     Json       @default("{}") // o'lcham, soni, logotip, manzil va h.k.
  productId   Int?
  managerNote String?
  utmSource   String?
  utmMedium   String?
  utmCampaign String?
  landingPage String?
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  workOrders WorkOrder[]

  @@index([type, status, createdAt])
}

model SiteSetting {
  key       String   @id
  value     Json
  updatedAt DateTime @updatedAt
}

// ─── Sun'iy intellekt (Anthropic Claude) ─────────────────────────────────────

// Kunlik tekshiruv hisoboti: aniq qoidalar bo'yicha topilgan muammolar (checks) va ularning AI yozgan xulosasi (summary)
model AuditReport {
  id        Int      @id @default(autoincrement())
  trigger   String // cron | manual
  checks    Json // [{ key, severity, title, count, items, link }]
  summary   Json? // { headline, priorities: [{ title, why, action }], note } — AI kaliti bo'lmasa null
  model     String? // xulosani yozgan model
  createdAt DateTime @default(now())

  @@index([createdAt])
}

// AI so'rovlari hisobi kunlar bo'yicha (Toshkent sanasi): kunlik chegara va xarajatni kuzatish uchun
model AiUsage {
  day          String   @id // YYYY-MM-DD
  requests     Int      @default(0)
  inputTokens  Int      @default(0)
  outputTokens Int      @default(0)
  updatedAt    DateTime @updatedAt
}

// ─── Ishonchlilik ────────────────────────────────────────────────────────────

// Darhol yuborib bo'lmagan bot xabarlari navbati (Telegram vaqtincha ishlamaganda): davriy signal qayta yuboradi (telegram/outbox.ts)
model BotOutbox {
  id        Int       @id @default(autoincrement())
  bot       String // customer | staff
  chatId    String
  topic     String? // bitta narsaning holati haqidagi xabarlar (masalan order-status:15): yangisi chiqsa navbatdagi eskisi bekor bo'ladi
  html      String
  inline    Json? // inline tugmalar
  attempts  Int       @default(1) // shu paytgacha urinishlar soni (birinchisi — darhol yuborishga urinish)
  nextAt    DateTime // keyingi urinish vaqti
  lastError String?
  sentAt    DateTime? // yetib bordi
  failedAt  DateTime? // urinishlar tugadi, doimiy xato yoki eskirgan — endi yuborilmaydi
  createdAt DateTime  @default(now())

  @@index([sentAt, failedAt, nextAt])
  @@index([bot, chatId, topic])
}
